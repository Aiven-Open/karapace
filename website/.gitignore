# Dependencies
/node_modules

# Lockfile is intentionally not committed: an enterprise supply-chain policy
# (minimumReleaseAge) rejects freshly published deps, and a committed lockfile
# pins to exact versions that can fail that check. Letting each install
# re-resolve lets the policy pick vetted-age versions.
/pnpm-lock.yaml

# Production
/build

# Generated files
.docusaurus
.cache-loader
current-routes.json

# Python venv (not used by the site; may linger from local tooling)
/venv

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

